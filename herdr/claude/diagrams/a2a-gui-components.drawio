        <mxCell id="p1" value="页面一:工程列表&#xa;新建 / 删除 / 恢复工程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="browser">
